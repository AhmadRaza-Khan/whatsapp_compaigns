# ---- Server ----
# Domain pointing at this VPS (DNS A record). Caddy gets the HTTPS certificate automatically.
DOMAIN=campaigns.example.com
POSTGRES_PASSWORD=change-me-long-random
# 32+ random characters: openssl rand -hex 32
JWT_SECRET=change-me
APP_ENV=production

# ---- Bird (server only, never in the frontend) ----
# Workspace API key from Bird. Starts with bk_eu1_
BIRD_API_KEY=
BIRD_API_HOST=https://eu1.platform.bird.com
# Signing secret shown ONCE when the webhook subscription is created. Starts with whsec_
BIRD_WEBHOOK_SECRET=

# ---- Email for password resets (optional; without it the reset link is written to the api log) ----
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
